# Local development defaults. Django loads this file at startup.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_DOMAIN=127.0.0.1:8000

# Production database and storage
DATABASE_URL=
USE_S3=False
USE_CLOUDINARY=False
CLOUDINARY_URL=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keep this key stable across deploys; generate with Fernet.generate_key().
FACE_ENCRYPTION_KEY=
FACE_DETECTOR_MODEL=
FACE_RECOGNIZER_MODEL=
FACE_MATCH_THRESHOLD=0.46
CSRF_TRUSTED_ORIGINS=

# Gmail SMTP (requires a Google App Password; see README authentication setup)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EchoMoments <your-gmail-address@gmail.com>
BREVO_API_KEY=

# Optional Google sign-in (create OAuth credentials and allow this callback URL)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
